{
  "name": "retail-network-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Domain documentation for the retail-network ecosystem (an Amazon-like retail and logistics network) and how it connects to the warehouse-systems WMS/WES fleet: research, strategic and tactical DDD artifacts (ddd-crew), node and promise models, Vendor API.",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "npm run gen-api-docs:all && docusaurus start",
    "build": "npm run gen-api-docs:all && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc",
    "gen-api-docs:all": "docusaurus gen-api-docs all",
    "clean-api-docs:all": "docusaurus clean-api-docs all",
    "check:model": "python3 scripts/check_model.py --pages",
    "validate:mermaid": "node scripts/validate-mermaid.cjs $(grep -rl '```mermaid' docs --include='*.md' --include='*.mdx')"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "docusaurus-plugin-openapi-docs": "^5.2.0",
    "docusaurus-theme-openapi-docs": "^5.2.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.3.0",
    "playwright-core": "^1.64.1",
    "typescript": "~7.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "overrides": {
    "openapi-to-postmanv2": {
      "js-yaml": "^4.3.1"
    },
    "yaml": "^1.10.3",
    "uuid": "^11.1.1",
    "serialize-javascript": "^7.1.0",
    "webpack-dev-server": "^5.2.6",
    "sockjs": "^0.3.24"
  }
}
